# Copy to .env. Everything here is optional: with no model configured FINN runs on rules alone.

# --- Model (any OpenAI-compatible endpoint) ----------------------------------------------
# Two tiers. FAST does bulk reading (filings, transcripts). SMART does the one synthesis step.
# Model ids change often: confirm the current free-tier ids in your provider's console.

# Google AI Studio (free tier, large token allowance: the easiest fit)
FINN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FINN_LLM_API_KEY=
FINN_MODEL_FAST=gemini-2.5-flash-lite
FINN_MODEL_SMART=gemini-2.5-flash

# Groq (free tier, very fast, tighter tokens-per-minute)
# FINN_LLM_BASE_URL=https://api.groq.com/openai/v1
# FINN_MODEL_FAST=llama-3.1-8b-instant
# FINN_MODEL_SMART=openai/gpt-oss-120b

# Local, zero cost (Ollama)
# FINN_LLM_BASE_URL=http://localhost:11434/v1
# FINN_MODEL_FAST=llama3.1:8b

# Optional: USD per 1M tokens, so the cost meter shows money as well as calls.
# FINN_PRICE_FAST_IN=0.10
# FINN_PRICE_FAST_OUT=0.40
# FINN_PRICE_SMART_IN=0.30
# FINN_PRICE_SMART_OUT=2.50

# --- Accounts (optional) ------------------------------------------------------------------
# Without FINN_USERS everyone gets analyst access: right for your own machine.
# With it, visitors are guests (read everything, rules only) until they sign in.
#   python -m finn.users secret              -> FINN_SECRET
#   python -m finn.users add manas admin     -> one FINN_USERS entry (password is hashed)
# FINN_SECRET=
# FINN_USERS=manas:admin:scrypt:...;reviewer:analyst:scrypt:...

# --- Cost guard-rails ----------------------------------------------------------------------
# FINN_LLM_DAILY_CALLS=400     # live model calls per UTC day; 0 = no cap
# FINN_LLM_DAILY_USD=0.50      # needs FINN_PRICE_* set; 0 = no money cap

# --- Push when the app is closed (python -m finn.watch) ----------------------------------
# FINN_TELEGRAM_TOKEN=
# FINN_TELEGRAM_CHAT=

# --- Misc ---------------------------------------------------------------------------------
# PORT=8000
# FINN_SAMPLE=1      # offline demo with invented companies; never use for a real demo
